<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/headerSectionSettings"
        android:layout_width="0dp"
        android:layout_height="@dimen/header_fixed_height"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/screen_top_margin"
        android:layout_marginEnd="@dimen/screen_horizontal_margin"
        android:background="@drawable/header_section_bg"
        android:clipChildren="false"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/header_card_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.SacredDirection.HeadlineLarge.AppName" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Settings"
                android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium" />

        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/scroll_content_bottom_padding"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSectionSettings">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/header_content_gap">

            <LinearLayout
                android:id="@+id/settingsPrayerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/header_section_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:elevation="4dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculation Asr Method"
                    android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.Section" />

                <RadioGroup
                    android:id="@+id/radioGroupAsr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="2dp">
                    <RadioButton
                        android:id="@+id/radioAsrShafii"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:text="Shafi'i"
                        android:textColor="@color/dark_text"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control" />
                    <RadioButton
                        android:id="@+id/radioAsrHanafi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:text="Hanafi"
                        android:textColor="@color/dark_text"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control"
                        android:layout_marginStart="20dp" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fixed Fajr Time"
                        android:textColor="@color/dark_text"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchFajrFixed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1.5 hours before sunrise"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall.Secondary"
                    android:layout_marginStart="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fixed Isha Time"
                        android:textColor="@color/dark_text"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchIshaFixed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1.5 hours after Maghrib"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall.Secondary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsHijriCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/header_section_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:elevation="4dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hijri_settings_title"
                    android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.Section" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleHijriOffset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHijriMinus"
                        style="@style/Widget.SacredDirection.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hijri_offset_minus" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHijriZero"
                        style="@style/Widget.SacredDirection.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hijri_offset_zero" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHijriPlus"
                        style="@style/Widget.SacredDirection.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hijri_offset_plus" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsReminderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/header_section_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:elevation="4dp"
                android:layout_marginBottom="@dimen/header_content_gap">

                <LinearLayout
                    android:id="@+id/rowReminderPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/reminder_perm_title"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:id="@+id/textReminderPermSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyMedium"
                        android:textColor="@color/gray_text" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsExtraCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/header_section_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp"
                android:elevation="4dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about"
                    android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.Section"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/textSettingsVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodyMedium.Secondary" />

                <TextView
                    android:id="@+id/btnPrivacyPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/privacy_open"
                    android:textAppearance="@style/TextAppearance.SacredDirection.LabelLarge.Link"
                    android:padding="4dp"
                    android:background="?android:attr/selectableItemBackground" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
