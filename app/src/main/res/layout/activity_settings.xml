<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/screen_top_margin"
            android:paddingBottom="@dimen/scroll_content_bottom_padding">

            <!-- Шапка: Настройки -->
            <FrameLayout
                android:id="@+id/headerSectionSettings"
                android:layout_width="match_parent"
                android:layout_height="@dimen/header_fixed_height"
                android:background="@drawable/header_section_bg"
                android:layout_marginBottom="@dimen/header_content_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/app_name"
                        android:textAppearance="@style/TextAppearance.SacredDirection.HeadlineLarge.AppName" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/nav_settings"
                        android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium" />

                </LinearLayout>
            </FrameLayout>

            <!-- Карточка выбора языка (Language Switcher) -->
            <LinearLayout
                android:id="@+id/settingsLanguageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/prayer_card_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/language_title"
                    android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.Section" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/hijri_segment_group_bg"
                    android:clipToOutline="true"
                    android:padding="1dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLangEn"
                            style="@style/Widget.SacredDirection.SegmentedButton.Left"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:saveEnabled="false"
                            android:text="@string/lang_en" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLangRu"
                            style="@style/Widget.SacredDirection.SegmentedButton.Middle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:saveEnabled="false"
                            android:text="@string/lang_ru" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLangAr"
                            style="@style/Widget.SacredDirection.SegmentedButton.Right"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:saveEnabled="false"
                            android:text="@string/lang_ar" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsPrayerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/prayer_card_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/asr_calculation_method"
                    android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.Section" />

                <RadioGroup
                    android:id="@+id/radioGroupAsr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="2dp">
                    <RadioButton
                        android:id="@+id/radioAsrShafii"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:text="@string/asr_shafii"
                        android:textColor="@color/dark_text"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control" />
                    <RadioButton
                        android:id="@+id/radioAsrHanafi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:text="@string/asr_hanafi"
                        android:textColor="@color/dark_text"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control"
                        android:layout_marginStart="20dp" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/switch_fixed_fajr"
                        android:textColor="@color/dark_text"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control" />
                    <com.example.qiblaapp2.NeumorphicSwitchView
                        android:id="@+id/switchFajrFixed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/switch_fixed_fajr" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fixed_fajr_desc"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall.Secondary"
                    android:layout_marginStart="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/switch_fixed_isha"
                        android:textColor="@color/dark_text"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control" />
                    <com.example.qiblaapp2.NeumorphicSwitchView
                        android:id="@+id/switchIshaFixed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/switch_fixed_isha" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fixed_isha_desc"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall.Secondary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsHijriCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/prayer_card_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hijri_settings_title"
                    android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.Section" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/hijri_segment_group_bg"
                    android:clipToOutline="true"
                    android:padding="1dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleHijriOffset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHijriMinus"
                            style="@style/Widget.SacredDirection.SegmentedButton.Left"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hijri_offset_minus" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHijriZero"
                            style="@style/Widget.SacredDirection.SegmentedButton.Middle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hijri_offset_zero" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHijriPlus"
                            style="@style/Widget.SacredDirection.SegmentedButton.Right"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hijri_offset_plus" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsReminderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/prayer_card_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="@dimen/header_content_gap">

                <LinearLayout
                    android:id="@+id/rowReminderPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/reminder_perm_title"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:id="@+id/textReminderPermSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyMedium"
                        android:textColor="@color/gray_text" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardShareApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/prayer_card_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_share"
                    android:contentDescription="@string/share_app_title" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/share_app_title"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control"
                    android:textColor="@color/dark_text" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_forward"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsExtraCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/prayer_card_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about"
                    android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.Section"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/textSettingsVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodyMedium.Secondary" />


                <TextView
                    android:id="@+id/btnPrivacyPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/privacy_open"
                    android:textAppearance="@style/TextAppearance.SacredDirection.LabelLarge.Link.Warm"
                    android:padding="4dp"
                    android:background="?android:attr/selectableItemBackground" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_marginStart="@dimen/bottom_nav_floating_margin_horizontal"
        android:layout_marginEnd="@dimen/bottom_nav_floating_margin_horizontal"
        android:layout_marginBottom="@dimen/bottom_nav_floating_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
