<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_panel_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/sheet_row_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/reminder_perm_title"
                android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.Section"
                android:textColor="@color/dark_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/reminder_perm_message"
                android:textAppearance="@style/TextAppearance.SacredDirection.BodyMedium"
                android:textColor="@color/dark_text" />

            <TextView
                android:id="@+id/textSheetNextStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/perm_status_allow_bg"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/reminder_perm_next_notifications"
                android:textAppearance="@style/TextAppearance.SacredDirection.BodyMedium"
                android:textColor="@color/alarm_label_on" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/sheet_card_bg"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/rowSheetLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_perm_location"
                            android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control"
                            android:textColor="@color/dark_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/reminder_perm_location_desc"
                            android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall"
                            android:textColor="@color/gray_text" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusSheetLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/perm_status_allow_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/reminder_perm_status_allow"
                        android:textAppearance="@style/TextAppearance.SacredDirection.LabelLarge"
                        android:textColor="@color/alarm_label_on" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/blue_border" />

                <LinearLayout
                    android:id="@+id/rowSheetNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_perm_notifications"
                            android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control"
                            android:textColor="@color/dark_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/reminder_perm_notifications_desc"
                            android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall"
                            android:textColor="@color/gray_text" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusSheetNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/perm_status_allow_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/reminder_perm_status_allow"
                        android:textAppearance="@style/TextAppearance.SacredDirection.LabelLarge"
                        android:textColor="@color/alarm_label_on" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/blue_border" />

                <LinearLayout
                    android:id="@+id/rowSheetExactAlarms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_perm_exact_alarms"
                            android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control"
                            android:textColor="@color/dark_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/reminder_perm_exact_alarms_desc"
                            android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall"
                            android:textColor="@color/gray_text" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusSheetExactAlarms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/perm_status_allow_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/reminder_perm_status_allow"
                        android:textAppearance="@style/TextAppearance.SacredDirection.LabelLarge"
                        android:textColor="@color/alarm_label_on" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/blue_border" />

                <LinearLayout
                    android:id="@+id/rowSheetBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_perm_battery"
                            android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.Control"
                            android:textColor="@color/dark_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/reminder_perm_battery_desc"
                            android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall"
                            android:textColor="@color/gray_text" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusSheetBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/perm_status_allow_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/reminder_perm_status_allow"
                        android:textAppearance="@style/TextAppearance.SacredDirection.LabelLarge"
                        android:textColor="@color/alarm_label_on" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetAllSet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/neo_sheet_button_secondary"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="@string/reminder_perm_later"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.SacredDirection.LabelLarge.ButtonSecondary"
        app:backgroundTint="@null"
        app:cornerRadius="16dp"
        app:rippleColor="@color/neo_shadow_soft" />

</LinearLayout>
