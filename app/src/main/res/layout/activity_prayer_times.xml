<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Шапка: карточка с городом, датой и восходом -->
    <FrameLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/screen_top_margin"
        android:layout_marginEnd="@dimen/screen_horizontal_margin"
        android:background="@drawable/header_section_bg"
        android:clipChildren="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/header_card_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/textCityPrayerTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="City"
                android:textAppearance="@style/TextAppearance.SacredDirection.BodyMedium.Secondary" />

            <TextView
                android:id="@+id/textGregorianDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="3 June 2026"
                android:textAppearance="@style/TextAppearance.SacredDirection.TitleLarge.Date" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/prayer_sunrise"
                    android:src="@drawable/ic_sunrise"
                    android:tint="@color/gray_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="@string/prayer_sunrise"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall.Secondary" />

                <TextView
                    android:id="@+id/textSunriseTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="·"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall.Secondary" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/prayer_sunset"
                    android:src="@drawable/ic_sunset"
                    android:tint="@color/gray_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="@string/prayer_sunset"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall.Secondary" />

                <TextView
                    android:id="@+id/textSunsetTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18:00"
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Основной контент с карточками -->
    <ScrollView
        android:id="@+id/prayerScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/scroll_content_bottom_padding"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/header_content_gap">

            <!-- Карточка Fajr -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Время -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fajr Time"
                        android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.PrayerName" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/fajrTime"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.PrayerTime"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

                <!-- Кнопка будильника -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/alarmButtonFajr"
                        android:layout_width="@dimen/neo_alarm_button_size"
                        android:layout_height="@dimen/neo_alarm_button_size"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextFajr"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textAppearance="@style/TextAppearance.SacredDirection.LabelSmall.Alarm"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp"
                        android:paddingBottom="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Dhuhr -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dhuhr Time"
                        android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.PrayerName" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/dhuhrTime"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.PrayerTime"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/alarmButtonDhuhr"
                        android:layout_width="@dimen/neo_alarm_button_size"
                        android:layout_height="@dimen/neo_alarm_button_size"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextDhuhr"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textAppearance="@style/TextAppearance.SacredDirection.LabelSmall.Alarm"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp"
                        android:paddingBottom="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Asr -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asr Time"
                        android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.PrayerName" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/asrTime"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.PrayerTime"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/alarmButtonAsr"
                        android:layout_width="@dimen/neo_alarm_button_size"
                        android:layout_height="@dimen/neo_alarm_button_size"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextAsr"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textAppearance="@style/TextAppearance.SacredDirection.LabelSmall.Alarm"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp"
                        android:paddingBottom="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Maghrib -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib Time"
                        android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.PrayerName" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/maghribTime"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.PrayerTime"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/alarmButtonMaghrib"
                        android:layout_width="@dimen/neo_alarm_button_size"
                        android:layout_height="@dimen/neo_alarm_button_size"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextMaghrib"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textAppearance="@style/TextAppearance.SacredDirection.LabelSmall.Alarm"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp"
                        android:paddingBottom="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Isha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isha Time"
                        android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium.PrayerName" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/ishaTime"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodyLarge.PrayerTime"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/alarmButtonIsha"
                        android:layout_width="@dimen/neo_alarm_button_size"
                        android:layout_height="@dimen/neo_alarm_button_size"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextIsha"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textAppearance="@style/TextAppearance.SacredDirection.LabelSmall.Alarm"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp"
                        android:paddingBottom="1dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Нижняя панель -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_marginStart="@dimen/bottom_nav_floating_margin_horizontal"
        android:layout_marginEnd="@dimen/bottom_nav_floating_margin_horizontal"
        android:layout_marginBottom="@dimen/bottom_nav_floating_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>