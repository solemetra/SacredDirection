<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Заголовок с иконкой и датой -->
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp">

        <!-- TextView для города -->
        <TextView
            android:id="@+id/textCityPrayerTimes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="City"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/dateBlock"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="8dp"
            android:minWidth="40dp"
            android:maxWidth="200dp" />

        <!-- Дата и Today's справа -->
        <LinearLayout
            android:id="@+id/dateBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's"
                android:textSize="29sp"
                android:textStyle="bold"
                android:textColor="@color/dark_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 Muharram 1446"
                android:id="@+id/textGregorianDate"
                android:textSize="16sp"
                android:textColor="@color/dark_text"
                android:layout_marginTop="4dp" />

            <!-- Sunrise/Sunset блок -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/sunriseBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start|center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sunrise"
                        android:contentDescription="Sunrise icon"
                        android:tint="@color/gray_text"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sunrise"
                        android:textColor="@color/dark_text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:id="@+id/textSunriseTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="06:00"
                        android:textColor="@color/dark_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sunsetBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start|center_vertical"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sunset"
                        android:contentDescription="Sunset icon"
                        android:tint="@color/gray_text"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sunset"
                        android:textColor="@color/dark_text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:id="@+id/textSunsetTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18:00"
                        android:textColor="@color/dark_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Основной контент с карточками -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSection"
        android:layout_above="@+id/bottomNavigation"
        android:layout_marginTop="140dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <!-- Карточка Fajr -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="99dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <!-- Время -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fajr Time"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/fajrTime"
                        android:textSize="18sp"
                        android:textColor="#FF0000"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <!-- Кнопка будильника -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <View
                        android:id="@+id/alarmButtonFajr"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextFajr"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Dhuhr -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="99dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dhuhr Time"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/dhuhrTime"
                        android:textSize="18sp"
                        android:textColor="#FF0000"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <View
                        android:id="@+id/alarmButtonDhuhr"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextDhuhr"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Asr -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="99dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asr Time"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/asrTime"
                        android:textSize="18sp"
                        android:textColor="#FF0000"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <View
                        android:id="@+id/alarmButtonAsr"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextAsr"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Maghrib -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="99dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib Time"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/maghribTime"
                        android:textSize="18sp"
                        android:textColor="#FF0000"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <View
                        android:id="@+id/alarmButtonMaghrib"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextMaghrib"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Isha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="99dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isha Time"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/ishaTime"
                        android:textSize="18sp"
                        android:textColor="#FF0000"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <View
                        android:id="@+id/alarmButtonIsha"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextIsha"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Нижняя панель -->
    <include
        layout="@layout/bottom_navigation"
        android:layout_gravity="bottom" />

</FrameLayout>