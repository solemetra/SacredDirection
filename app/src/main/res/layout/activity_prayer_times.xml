<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Шапка: карточка с городом, датой и восходом -->
    <FrameLayout
        android:id="@+id/headerSection"
        android:layout_width="344dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:background="@drawable/header_section_bg"
        android:clipChildren="false"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/textCityPrayerTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="City"
                android:textColor="@color/gray_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textGregorianDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="3 June 2026"
                android:textColor="@color/dark_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/prayer_sunrise"
                    android:src="@drawable/ic_sunrise"
                    android:tint="@color/gray_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="@string/prayer_sunrise"
                    android:textColor="@color/gray_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textSunriseTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00"
                    android:textColor="@color/dark_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="·"
                    android:textColor="@color/gray_text"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/prayer_sunset"
                    android:src="@drawable/ic_sunset"
                    android:tint="@color/gray_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="@string/prayer_sunset"
                    android:textColor="@color/gray_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textSunsetTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18:00"
                    android:textColor="@color/dark_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Основной контент с карточками -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSection"
        android:layout_above="@+id/bottomNavigation"
        android:layout_marginTop="168dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="20dp">

            <!-- Карточка Fajr -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_marginBottom="15dp"
                android:elevation="2dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Время -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fajr Time"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/fajrTime"
                        android:textSize="17sp"
                        android:textColor="#FF0000"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

                <!-- Кнопка будильника -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/alarmButtonFajr"
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextFajr"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp"
                        android:paddingBottom="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Dhuhr -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_marginBottom="15dp"
                android:elevation="2dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dhuhr Time"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/dhuhrTime"
                        android:textSize="17sp"
                        android:textColor="#FF0000"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/alarmButtonDhuhr"
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextDhuhr"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp"
                        android:paddingBottom="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Asr -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_marginBottom="15dp"
                android:elevation="2dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asr Time"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/asrTime"
                        android:textSize="17sp"
                        android:textColor="#FF0000"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/alarmButtonAsr"
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextAsr"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp"
                        android:paddingBottom="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Maghrib -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_marginBottom="15dp"
                android:elevation="2dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib Time"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/maghribTime"
                        android:textSize="17sp"
                        android:textColor="#FF0000"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/alarmButtonMaghrib"
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextMaghrib"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp"
                        android:paddingBottom="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка Isha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/prayer_card_background"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_marginBottom="15dp"
                android:elevation="2dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isha Time"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/ishaTime"
                        android:textSize="17sp"
                        android:textColor="#FF0000"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/alarmButtonIsha"
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:background="@drawable/alarm_button_background" />

                    <TextView
                        android:id="@+id/alarmTextIsha"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Alarm ON"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp"
                        android:paddingBottom="1dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Нижняя панель -->
    <include
        layout="@layout/bottom_navigation"
        android:layout_gravity="bottom" />

</FrameLayout>