<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Кнопка возврата к текущему положению: круглая, с тенью, иконкой, выше нижней панели -->
    <ImageButton
        android:id="@+id/myLocationButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="92dp"
        android:background="@drawable/my_location_button_bg"
        android:src="@android:drawable/ic_menu_mylocation"
        android:scaleType="center"
        android:contentDescription="Вернуться к моему положению"
        android:elevation="8dp" />

    <!-- Направление и расстояние до Киблы (верхний левый угол) -->
    <LinearLayout
        android:id="@+id/qiblaBottomInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="40dp"
        android:elevation="8dp"
        android:background="@android:color/transparent"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <ImageView
                android:id="@+id/iconDirectionLabel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/navigation_07"
                android:contentDescription="Direction icon"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:tint="@color/gray_text" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start|center_vertical">
                <TextView
                    android:id="@+id/labelDirection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIRECTION TO QIBLA"
                    android:textAllCaps="true"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:layout_marginBottom="2dp" />
                <TextView
                    android:id="@+id/textQiblaAngle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_text"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/textQiblaDirection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_text"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/iconDistanceLabel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/navigation_02"
                android:contentDescription="Distance icon"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:tint="@color/gray_text" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start|center_vertical">
                <TextView
                    android:id="@+id/labelDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISTANCE TO QIBLA"
                    android:textAllCaps="true"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:layout_marginBottom="2dp" />
                <TextView
                    android:id="@+id/textDistanceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_text"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:layout_marginBottom="1dp" />
                <TextView
                    android:id="@+id/textDistanceUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KM"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_text"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Нижняя навигация поверх карты -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_nav_background"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="16dp">

        <!-- Direction (Активный экран) -->
        <LinearLayout
            android:id="@+id/btnDirection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab1_direction"
                android:tint="@color/blue_primary" />

        </LinearLayout>

        <!-- Prayer Times -->
        <LinearLayout
            android:id="@+id/btnPrayerTimes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab3_notification"
                android:tint="@color/gray_text" />

        </LinearLayout>

        <!-- Dua -->
        <LinearLayout
            android:id="@+id/btnDua"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab4_dua"
                android:tint="@color/gray_text" />

        </LinearLayout>

        <!-- Settings (новая вкладка) -->
        <LinearLayout
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab5_settings"
                android:tint="@color/gray_text" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>