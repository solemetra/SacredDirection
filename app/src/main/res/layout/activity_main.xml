<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Кнопка возврата к текущему положению: круглая, с тенью, иконкой, выше нижней панели -->
    <ImageButton
        android:id="@+id/myLocationButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="@dimen/fab_bottom_offset"
        android:background="@drawable/my_location_button_bg"
        android:src="@android:drawable/ic_menu_mylocation"
        android:scaleType="center"
        android:contentDescription="Вернуться к моему положению"
        android:elevation="8dp" />

    <!-- Направление и расстояние до Киблы (верхний левый угол) -->
    <LinearLayout
        android:id="@+id/qiblaBottomInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="40dp"
        android:elevation="8dp"
        android:background="@android:color/transparent"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <ImageView
                android:id="@+id/iconDirectionLabel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/navigation_07"
                android:contentDescription="Direction icon"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:tint="@color/gray_text" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start|center_vertical">
                <TextView
                    android:id="@+id/labelDirection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIRECTION TO QIBLA"
                    android:textAppearance="@style/TextAppearance.SacredDirection.LabelLarge.Uppercase"
                    android:fontFamily="sans-serif"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:layout_marginBottom="2dp" />
                <TextView
                    android:id="@+id/textQiblaAngle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textAppearance="@style/TextAppearance.SacredDirection.HeadlineSmall.Metric"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/textQiblaDirection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall.MetricHint"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/iconDistanceLabel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/navigation_02"
                android:contentDescription="Distance icon"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:tint="@color/gray_text" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start|center_vertical">
                <TextView
                    android:id="@+id/labelDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISTANCE TO QIBLA"
                    android:textAppearance="@style/TextAppearance.SacredDirection.LabelLarge.Uppercase"
                    android:fontFamily="sans-serif"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:layout_marginBottom="2dp" />
                <TextView
                    android:id="@+id/textDistanceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textAppearance="@style/TextAppearance.SacredDirection.HeadlineMedium.Metric"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:layout_marginBottom="1dp" />
                <TextView
                    android:id="@+id/textDistanceUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KM"
                    android:textAppearance="@style/TextAppearance.SacredDirection.LabelMedium.Unit"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Нижняя навигация поверх карты -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom" />

</FrameLayout>