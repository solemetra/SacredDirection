<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/headerSectionDua"
        android:layout_width="0dp"
        android:layout_height="@dimen/header_fixed_height"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/screen_top_margin"
        android:layout_marginEnd="@dimen/screen_horizontal_margin"
        android:background="@drawable/header_section_bg"
        android:clipChildren="false"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/header_card_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.SacredDirection.HeadlineLarge.AppName" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/nav_dua"
                android:textAppearance="@style/TextAppearance.SacredDirection.TitleMedium" />

        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/duaScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:paddingBottom="@dimen/scroll_content_bottom_padding"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSectionDua">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/header_content_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dua_card_background"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="16dp"
                android:layout_marginBottom="@dimen/header_content_gap"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/textBismillah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/dua_bismillah"
                    android:textAppearance="@style/TextAppearance.SacredDirection.TitleLarge.Bismillah"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="true"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="22sp"
                    app:autoSizeStepGranularity="1sp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:background="#332E7D32" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/dua_arabic_section_bg"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/textDuaArabic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/dua_arabic"
                        android:textAppearance="@style/TextAppearance.SacredDirection.HeadlineMedium.Arabic"
                        android:lineSpacingExtra="8dp"
                        android:includeFontPadding="true" />

                    <TextView
                        android:id="@+id/textDuaTranslation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="@string/dua_translation"
                        android:textAppearance="@style/TextAppearance.SacredDirection.BodySmall.Italic"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnPlayDua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/play_button_background"
                android:text="@string/play_dua"
                android:drawableLeft="@drawable/ic_play"
                android:drawablePadding="10dp"
                android:textAppearance="@style/TextAppearance.SacredDirection.LabelLarge.Button"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:elevation="4dp"
                android:foreground="?attr/selectableItemBackground" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
