<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SacredDirection" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryVariant">@color/blue_primary_variant</item>
        <item name="colorOnPrimary">@color/white_text</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/blue_primary_light</item>
        <item name="colorSecondaryVariant">@color/blue_primary_variant</item>
        <item name="colorOnSecondary">@color/white_text</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">#FFFFFF</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/blue_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Dark Theme -->
    <style name="Theme.SacredDirection.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_primary_light</item>
        <item name="colorPrimaryVariant">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/dark_text</item>
        <item name="colorSecondary">@color/blue_primary_light</item>
        <item name="colorSecondaryVariant">@color/blue_primary</item>
        <item name="colorOnSecondary">@color/dark_text</item>
        <item name="android:statusBarColor" tools:targetApi="l">#1B1B1B</item>
        <item name="android:windowBackground">#121212</item>
    </style>

    <!-- Settings Theme -->
    <style name="Theme.SacredDirection.Settings" parent="Theme.SacredDirection">
        <item name="android:textColorPrimary">@color/blue_primary</item>
    </style>
</resources>