<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="@dimen/neo_depth_offset_subtle"
        android:top="@dimen/neo_depth_offset_subtle">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_shadow_soft" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:right="@dimen/neo_depth_offset_subtle"
        android:bottom="@dimen/neo_depth_offset_subtle">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_surface" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/blue_border" />
        </shape>
    </item>
</layer-list>
