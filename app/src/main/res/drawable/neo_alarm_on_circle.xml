<?xml version="1.0" encoding="utf-8"?>
<!-- Alarm ON: raised — stronger depth than nav active -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="@dimen/neo_alarm_on_depth"
        android:top="@dimen/neo_alarm_on_depth">
        <shape android:shape="oval">
            <solid android:color="@color/neo_shadow_soft" />
        </shape>
    </item>
    <item
        android:right="@dimen/neo_alarm_on_depth"
        android:bottom="@dimen/neo_alarm_on_depth">
        <shape android:shape="oval">
            <solid android:color="@color/neo_surface_high" />
            <stroke
                android:width="1dp"
                android:color="@color/blue_border" />
        </shape>
    </item>
</layer-list>
