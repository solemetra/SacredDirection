<?xml version="1.0" encoding="utf-8"?>
<!-- Flat centered disc — glyph aligns with visible circle (no offset shadow) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/blue_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/neo_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/blue_border" />
        </shape>
    </item>
</selector>
