<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Внутренняя тень (имитация inset shadow) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="90%"
                android:centerX="50%"
                android:centerY="50%"
                android:startColor="#220E3268"
                android:endColor="#00FCFDFF"/>
        </shape>
    </item>
    <!-- Основной круг -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#F3F8FF"/>
            <stroke android:width="5dp" android:color="#ECF4FF"/>
        </shape>
    </item>
</layer-list> 