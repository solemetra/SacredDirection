<?xml version="1.0" encoding="utf-8"?>
<!-- Convex disc: radial highlight top-left, no offset shadow blob -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="72%p"
                android:centerX="0.36"
                android:centerY="0.36"
                android:startColor="@color/neo_surface_high"
                android:centerColor="@color/neo_surface"
                android:endColor="@color/neo_switch_thumb_bottom" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/neo_highlight_stroke" />
        </shape>
    </item>
</layer-list>
