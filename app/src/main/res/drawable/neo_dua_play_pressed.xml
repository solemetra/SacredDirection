<?xml version="1.0" encoding="utf-8"?>
<!-- Concave disc: light from bottom-right, pressed in -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="72%p"
                android:centerX="0.64"
                android:centerY="0.64"
                android:startColor="@color/neo_switch_thumb_bottom"
                android:centerColor="@color/neo_surface"
                android:endColor="@color/neo_surface_high" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/neo_border_subtle" />
        </shape>
    </item>
</layer-list>
